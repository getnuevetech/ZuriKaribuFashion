NODE_ENV=production
PORT=3001

# Core
DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=replace-with-strong-secret

# CORS
FRONTEND_URL=https://your-frontend-domain.com

# Stripe
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Optional: S3 uploads for stateless containers
AWS_UPLOADS_ENABLED=true
AWS_UPLOADS_BUCKET=african-fashion-uploads
AWS_UPLOADS_REGION=us-east-1
AWS_UPLOADS_PREFIX=uploads
AWS_UPLOADS_BASE_URL=https://cdn.your-domain.com
# Optional aliases also supported by the API upload route:
# S3_BUCKET, AWS_S3_BUCKET, AWS_BUCKET_NAME, S3_REGION, S3_BASE_URL
# Keep required in production so uploads never fall back to local disk storage.
AWS_UPLOADS_REQUIRE_S3=true

