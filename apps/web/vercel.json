{
  "framework": "vite",
  "redirects": [
    {
      "source": "/",
      "destination": "/main",
      "permanent": false
    },
    {
      "source": "/home",
      "destination": "/main",
      "permanent": false
    },
    {
      "source": "/home/",
      "destination": "/main",
      "permanent": false
    },
    {
      "source": "/home-legacy",
      "destination": "/main",
      "permanent": false
    },
    {
      "source": "/home-live",
      "destination": "/main",
      "permanent": false
    },
    {
      "source": "/jenks-dynamic",
      "destination": "/main",
      "permanent": false
    },
    {
      "source": "/home-jenks",
      "destination": "/main",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/main",
      "destination": "/main/index.html"
    },
    {
      "source": "/main/",
      "destination": "/main/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
