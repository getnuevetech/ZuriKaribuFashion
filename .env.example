# Copy to .env on the Lightsail server. scripts/lightsail-up.sh does this
# and generates the two secrets when .env is missing.
# Use letters and numbers only in POSTGRES_PASSWORD.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=african_fashion

JWT_SECRET=change-me

# Public site URL. Use the Lightsail static IP, or https://your-domain.
FRONTEND_URL=http://YOUR_STATIC_IP
HTTP_PORT=80

# Fresh database. Schema is applied with prisma db push on API startup.
SEED_ON_BOOT=true
SEED_DEMO_PRODUCTS=true

# Optional. Leave blank until Stripe is configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLIC_KEY=
